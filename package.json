{
  "name": "cc-bidding-project-2025",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "seed-test-data": "powershell -NoProfile -Command \"$env:RUN_SEED_SCRIPT='true'; npx ts-node -r tsconfig-paths/register --project tsconfig.script.json src/scripts/seed-test-data.ts\"",
    "import-excel": "powershell -NoProfile -Command \"$env:RUN_IMPORT_SCRIPT='true'; npx ts-node -r tsconfig-paths/register --project tsconfig.script.json src/scripts/import-excel-teams.ts\"",
    "test:watch": "jest --watch",
    "init-data": "npx tsx src/scripts/init-data.ts",
    "reset-auction": "powershell -NoProfile -Command \"$env:RUN_RESET_AUCTION='true'; npx tsx src/scripts/reset-auction.ts\"",
    "full-reset": "npx tsx src/scripts/full-reset.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.548.0",
    "mongodb": "^6.20.0",
    "next": "16.0.1",
    "postcss": "^8.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xlsx": "^0.0.35",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.6.1",
    "mongodb-memory-server": "^8.12.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.16",
    "ts-jest": "^29.1.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.9",
    "utf-8-validate": "^6.0.5"
  }
